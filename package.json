    "web:preview": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.372",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "^4.0.372"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.16.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.14"
  }
}
