{
  "private": true,
  "name": "lp-optimizer-remotion-demo",
  "version": "1.0.0",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "render": "remotion render src/index.ts LPOptimizerDemo out/lp-optimizer-demo.mp4",
    "check": "tsc --noEmit",
